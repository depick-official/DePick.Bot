{
  "name": "depick-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode dev",
    "build:uat": "tsc && vite build --mode uat --outDir dist-uat",
    "build:prod": "tsc && vite build --mode prod --outDir dist-prod",
    "build:all": "npm run build:uat && npm run build:prod",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "jwt-decode": "^4.0.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "sass": "^1.69.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
